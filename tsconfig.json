{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "dungeonmind-canvas": ["node_modules/dungeonmind-canvas/dist/index.d.ts"],
      "dungeonmind-canvas/layout": ["node_modules/dungeonmind-canvas/dist/layout/index.d.ts"],
      "dungeonmind-canvas/map": ["node_modules/dungeonmind-canvas/dist/map/index.d.ts"]
    },
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "jest",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src"
  ]
}
